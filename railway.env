# ============================================================
# משתני סביבה למערכת ימות הש"ס - להעלאה לראילוואי
# ============================================================
# איך מעלים: בפרויקט שלכם בראילוואי -> הכרטיסייה "Variables" ->
# כפתור "Raw Editor" (או "Edit as Raw" / אייקון </>) -> מדביקים
# את כל התוכן הזה בבת אחת -> Save/Deploy.
#
# שורות שמסומנות ב-⚠️ בהערה שמעליהן חייבות עריכה ידנית לפני
# שהמערכת תעבוד באמת. כל השאר כבר מוכן לשימוש.
# ============================================================

# --- כללי ---
NODE_ENV=production
PORT=3000

# --- נתיבי אחסון ---
# ⚠️ מניחים שהגדרתם Volume בראילוואי המעוגן ב-Mount Path בדיוק /data
# (Settings -> Volumes -> Add Volume). בלי Volume כזה, הנתיבים האלה
# יגרמו לשרת לקרוס בהפעלה (שגיאת הרשאות כתיבה) - אם עדיין אין לכם
# Volume, שנו זמנית בחזרה לנתיב יחסי כמו ./data/shas-content.
#
# היתרון של /data + Volume: תוכן שנבנה נשאר קבוע גם אחרי דיפלוי חדש -
# לא נמחק בכל פעם כמו עם נתיב יחסי.
CONTENT_ROOT=/data/shas-content
TMP_ROOT=/data/tmp
DRAFTS_ROOT=/data/drafts
DB_FILE=/data/state.db

# --- ויקיטקסט (לא לגעת) ---
WIKISOURCE_API=https://he.wikisource.org/w/api.php

# ⚠️ קוד הכניסה לממשק הניהול (/admin) - כבר נוצר עבורכם באקראי.
# אפשר להשאיר כמו שהוא או להחליף למשהו שקל לכם לזכור.
ADMIN_ACCESS_CODE=cbf1f16a

# מפתח סודי לחתימת עוגיית הסשן - כבר נוצר אקראי, אין צורך לגעת.
SESSION_SECRET=2a9bf7e68534f127a66e56a785e52c3bb79aafc2987183c5f96fbbf0103a9121

# --- שירות ניקוד (דיקטה, חינמי) - לא לגעת ---
DICTA_NAKDAN_URL=https://nakdan-u1-0.loadbalancer.dicta.org.il/api

# ⚠️ פיסוק אוטומטי (Claude API) - כפתור נפרד מהניקוד בממשק (לא כפוי),
# כי זה עולה כסף (בניגוד לניקוד שחינמי). אומדן גס לכל הש"ס: כ-$60-120.
# קבלו מפתח ב-https://console.anthropic.com. אם משאירים ריק - רק כפתור
# "פיסוק" לא יעבוד, ניקוד ימשיך לעבוד רגיל בלי עלות.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ⚠️ ספק ה-TTS: Google Cloud Text-to-Speech
TTS_VOICE_NORMAL=
TTS_VOICE_BOLD=
# 1. צרו פרויקט ב-console.cloud.google.com, הפעילו "Text-to-Speech API"
# 2. צרו API key (APIs & Services -> Credentials -> Create Credentials -> API Key)
# 3. הריצו מקומית: node pipeline/listGoogleVoices.js
#    זה ייתן רשימה אמיתית של שמות קולות עבריים - העתיקו שניים (רגיל+מודגש)
#    לשני המשתנים למעלה (TTS_VOICE_NORMAL/TTS_VOICE_BOLD)
GOOGLE_TTS_API_KEY=

# ⚠️ פרטי חשבון הניהול שלכם בימות המשיח - למלא לפני שמנסים להעלות
# תוכן (כפתור "העלה לימות" בממשק, או pipeline/run.js עם ENABLE_UPLOAD=yes)
YEMOT_USERNAME=
YEMOT_PASSWORD=
YEMOT_API_BASE=https://www.call2all.co.il/ym/api

# הרצות batch (pipeline/batchRun.js) - לא לגעת, ברירת מחדל סבירה
PIPELINE_DELAY_MS=1500
PIPELINE_MAX_RETRIES=3
ENABLE_UPLOAD=no

# ⚠️⚠️ החשוב ביותר - יש למלא את זה *אחרי* שראילוואי ייתן לכם כתובת
# ציבורית (בכרטיסייה Settings -> Networking -> Generate Domain).
# הכתובת נראית כמו https://<שם-הפרויקט>.up.railway.app
# יש להדביק אותה כאן עם הסיומת /api/player/control, ולעדכן מחדש
# (Save שוב) אחרי שמקבלים את הכתובת - וגם להזין אותה בשלוחת ה-ext.ini
# הראשית בימות (config/ext-api-main.ini, בשדה api_link, עם /api/ivr/main)
API_PLAYER_URL=https://kol-hatora-production.up.railway.app/api/player/control

# ⚠️ נדרש כדי ש-ffmpeg יהיה זמין בזמן ריצה (מערכת הבנייה של ראילוואי,
# Railpack, לא מתקינה אותו כברירת מחדל - זה גורם קידוד/חיבור אודיו).
# יש גם railpack.json בשורש הפרויקט שעושה את זה בדיוק - זה כאן זו
# "רשת ביטחון" נוספת, לא חובה אם ה-railpack.json כבר עובד.
RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg
